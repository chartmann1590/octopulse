# OctoPulse — AdMob / env template
# Copy this to .env (which is gitignored) and fill in production IDs locally.
# In CI, these are provided as GitHub Secrets (never committed).

# Android AdMob App ID (ca-app-pub-...~...)
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=

# Banner Ad Unit ID (ca-app-pub-.../...)
ADMOB_BANNER_AD_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=

# Interstitial Ad Unit ID (ca-app-pub-.../...)
ADMOB_INTERSTITIAL_AD_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=

# Optional: iOS AdMob App ID (if/when iOS build)
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Example with Google test IDs (used automatically when env not set):
# ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
# ADMOB_BANNER_AD_ID=ca-app-pub-3940256099942544/6300978111
# ADMOB_INTERSTITIAL_AD_ID=ca-app-pub-3940256099942544/1033173712
